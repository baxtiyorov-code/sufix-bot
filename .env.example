# Скопируй этот файл в .env и заполни своими значениями.
# НИКОГДА не коммить .env в git и никому не показывай его содержимое.

# Токен бота от @BotFather
BOT_TOKEN=

# API-ключ VirusTotal (получить на https://www.virustotal.com/gui/my-apikey)
VIRUSTOTAL_API_KEY=

# Telegram user ID администраторов через запятую (узнать свой ID — у @userinfobot).
# Полный доступ: /stats + безлимитные проверки (дневной лимит и токены не расходуются).
ADMIN_CHAT_ID=

# Username(ы) администраторов через запятую, без @ (регистр не важен).
# Альтернатива ADMIN_CHAT_ID, если ID неизвестен. Тот же полный доступ.
ADMIN_USERNAMES=

# Путь к базе данных SQLite (менять не нужно)
DATABASE_URL=file:./dev.db
