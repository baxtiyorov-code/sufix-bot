# Скопируй этот файл в .env и заполни своими значениями.
# НИКОГДА не коммить .env в git и никому не показывай его содержимое.

# Токен бота от @BotFather
BOT_TOKEN=

# API-ключ VirusTotal (получить на https://www.virustotal.com/gui/my-apikey)
VIRUSTOTAL_API_KEY=

# Telegram user ID администраторов через запятую (узнать свой ID — у @userinfobot).
# Полный доступ: /stats + безлимитные проверки (дневной лимит и токены не расходуются).
ADMIN_CHAT_ID=

# Username(ы) администраторов через запятую, без @ (регистр не важен).
# Альтернатива ADMIN_CHAT_ID, если ID неизвестен. Тот же полный доступ.
ADMIN_USERNAMES=

# Postgres (Supabase). DATABASE_URL — пуллер (порт 6543), для рантайма.
# DIRECT_URL — прямое соединение (порт 5432), только для `prisma migrate`.
# Взять в Supabase: Project Settings → Database → Connection string.
DATABASE_URL=
DIRECT_URL=

# Только для деплоя на Vercel (webhook вместо long polling):
# полный URL функции после деплоя, напр. https://ваш-проект.vercel.app/api/webhook
WEBHOOK_URL=
# Произвольная случайная строка — Telegram присылает её в каждом запросе,
# так вебхук проверяет, что запрос действительно от Telegram. Одно и то же
# значение должно быть и в .env, и в переменных окружения на Vercel.
TELEGRAM_WEBHOOK_SECRET=
