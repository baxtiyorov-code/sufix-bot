{
  "name": "tg-antivirus-bot",
  "version": "1.0.0",
  "description": "Guardix — Telegram-бот для проверки PDF/APK файлов на угрозы",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "prisma migrate deploy && node dist/index.js",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:studio": "prisma studio",
    "webhook:set": "tsx scripts/set-webhook.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "form-data": "^4.0.0",
    "grammy": "^1.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@vercel/node": "^13.0.1",
    "prisma": "^5.19.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
