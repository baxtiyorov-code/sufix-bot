// Supabase-проект общий с другим вашим приложением (таблицы agents/tasks/
// projects/profiles и т.д. в той же базе) — multiSchema нужен только затем,
// чтобы Prisma не спотыкалась об их внешний ключ profiles → auth.users при
// диагностике схемы. Сами эти таблицы Prisma не описывает и не трогает.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL — пуллер соединений (Supabase: порт 6543), для рантайма.
  url       = env("DATABASE_URL")
  // DIRECT_URL — прямое соединение (Supabase: порт 5432), только для миграций.
  directUrl = env("DIRECT_URL")
  schemas   = ["public", "auth"]
}

model Scan {
  id         Int      @id @default(autoincrement())
  kind       String   @default("file") // "file" | "url"
  fileName   String // для ссылок — сам адрес
  fileType   String // "PDF" | "APK" | "URL"
  fileHash   String // для ссылок — urlId (base64url)
  fileSizeMb Float // для ссылок — 0
  malicious  Int
  suspicious Int
  harmless   Int
  undetected Int
  verdict    String // "clean" | "suspicious" | "malicious"
  userId     BigInt
  username   String?
  chatId     BigInt
  permalink  String
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([fileHash])
  @@schema("public")
}

model UserSettings {
  userId        BigInt   @id
  username      String?
  language      String   @default("en") // "ru" | "en" | "uz"
  firstSeenAt   DateTime @default(now())
  paidTokens    Int      @default(0)
  freeScansUsed Int      @default(0)
  freeScansDate String   @default("")
  blocked       Boolean  @default(false)

  @@schema("public")
}